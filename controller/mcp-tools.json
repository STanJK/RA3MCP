[
  {
    "name": "ra3_click",
    "description": "Click a mouse button through the verified game input pump. No focus delay. Never automatically retry after an error, timeout or cancellation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Explicit game PID from a bridge endpoint; required on every game call."
        },
        "button": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "middle"
          ],
          "default": "left"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Game client pixels, excluding window borders; bridge checks the actual client size."
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Game client pixels, excluding window borders; bridge checks the actual client size."
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000,
          "default": 80
        }
      },
      "required": [
        "pid",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "Explicit game PID from a bridge endpoint; required on every game call."
        },
        "status": {
          "type": "string",
          "enum": [
            "pumped"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "pump": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "held": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "detail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "not_sent",
                "unknown"
              ]
            },
            "retryable": {
              "type": "boolean",
              "const": false
            },
            "os_error": {
              "type": "integer"
            }
          },
          "required": [
            "code",
            "message",
            "outcome",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
